# Supabase (ver docs/SUPABASE_SETUP.md)
# Copia este archivo a .env y rellena con tus valores del dashboard:
# Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hugging Face Inference (para el tutor IA y el Sprint IA — gratis con límites)
# Token: https://huggingface.co/settings/tokens (permiso "read" alcanza)
VITE_HF_API_KEY=
# Opcional — modelo instruct a usar (por defecto: Qwen/Qwen2.5-7B-Instruct)
VITE_HF_MODEL=

# Supabase (ver docs/SUPABASE_SETUP.md)
# Copia este archivo a .env y rellena con tus valores del dashboard:
# Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# El tutor IA y el Sprint IA hablan con backend/ (ver backend/.env.example),
# no directamente con Hugging Face — así el token nunca llega al navegador.
# En local: corre el backend aparte (cd backend && npm run dev) y el proxy
# de Vite reenvía /api ahí (ver vite.config.ts).

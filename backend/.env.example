# Server
PORT=5000

# Hugging Face Inference (tutor IA + Sprint IA — gratis con límites)
# Token: https://huggingface.co/settings/tokens (permiso "read" alcanza)
HF_API_KEY=
# Opcional — modelo instruct a usar (por defecto: Qwen/Qwen2.5-7B-Instruct)
HF_MODEL=

# CORS — URL del frontend en desarrollo local (no hace falta en el Docker
# Space, donde frontend y backend se sirven desde el mismo origen)
FRONTEND_URL=http://localhost:5173

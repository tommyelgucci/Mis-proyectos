# Server
PORT=5000

# Groq (tutor IA + Sprint IA + Clase con IA — gratis, muy rápido)
# Clave: https://console.groq.com/keys
GROQ_API_KEY=
# Opcional — modelo a usar (por defecto: openai/gpt-oss-120b)
GROQ_MODEL=

# CORS — URL del frontend en desarrollo local (no hace falta en SnapDeploy,
# donde frontend y backend se sirven desde el mismo origen)
FRONTEND_URL=http://localhost:5173

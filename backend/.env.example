# Server
PORT=5000

# Groq (tutor IA + Sprint IA + Clase con IA — gratis, muy rápido)
# Clave: https://console.groq.com/keys
GROQ_API_KEY=
# Opcional — modelo a usar (por defecto: openai/gpt-oss-120b)
GROQ_MODEL=

# CORS — URL del frontend en desarrollo local. NO definirla en SnapDeploy:
# allí frontend y backend comparten origen y no hace falta ninguna cabecera
# cross-origin. Dejarla vacía cierra el CORS, que es lo que queremos en
# producción (si no, cualquier web podría llamar a nuestro proxy de IA desde
# el navegador de sus visitantes).
FRONTEND_URL=http://localhost:5173

# Saltos de proxy en los que confiar para deducir la IP real del cliente
# (la usa el rate limit de /api/ai/complete). SnapDeploy pone un proxy
# delante del contenedor → 1. Solo cámbialo si sabes que hay otra topología.
TRUST_PROXY=1

{
  "name": "brainbit-backend",
  "version": "0.1.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:web": "cd ../frontend && npm install && npm run build && rm -rf ../backend/public && cp -r dist ../backend/public",
    "serve": "npm run build:web && node server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5"
  }
}
